# Salin ke .env (jangan di-commit). Nilai di bawah hanya untuk pengembangan lokal.
ENV=dev

# Role runtime aplikasi: BUKAN pemilik tabel, NOBYPASSRLS (RLS berlaku)
APP_DATABASE_URL=postgresql+asyncpg://bussn_app:bussn_app_dev@localhost:5432/bussnapp

# Role migrasi: pemilik tabel. Hanya dipakai Alembic.
MIGRATOR_DATABASE_URL=postgresql+psycopg://bussn_owner:bussn_owner_dev@localhost:5432/bussnapp

REDIS_URL=redis://localhost:6379/0

# Ganti dengan string acak panjang (openssl rand -hex 32)
JWT_SECRET=ganti-dengan-rahasia-acak
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
